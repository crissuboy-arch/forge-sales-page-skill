# Criador de Páginas — provider de IA (server-side, nunca no navegador/bundle/git)
NVIDIA_API_KEY=

# Prospecção — motor AIsa (aisa.one): Google Maps + Instagram + IA na mesma chave
AISA_KEY=

# Publicação de demos — Vercel Blob (Project → Storage → Blob → Connect)
# Também usado pelo job ledger do PageForge Executor Bridge (Cris OS).
BLOB_READ_WRITE_TOKEN=

# PageForge Executor Bridge — autenticação server-to-server do Cris OS
# (POST/GET /api/integrations/cris-os/work-orders). Token opaco, gerado por
# você (ex.: openssl rand -hex 32); o mesmo valor vai na env do Cris OS como
# credencial de saída. Sem esta variável, o endpoint recusa toda requisição.
CRIS_OS_BRIDGE_TOKEN=
